# Dotfiles are opt-in.
/.*
!/.gitignore
!/.gitattributes
!/.github/

# Agent config and personal overrides, at any depth.
.agents
CLAUDE*
.claude
*.local.*

# Build output, per language.
/rust/target/
/python/.venv/
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
/ts/node_modules/
/dart/.dart_tool/
/dart/pubspec.lock
# Staged for the browser run by dart/tool/stage_vectors.dart.
/dart/test/vectors/

# A library does not commit its lockfile.
/rust/Cargo.lock

# Docs build
/site/
